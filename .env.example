# ---------------------------------------------------------------------------
# Wield — variables d'environnement
# Copie ce fichier en .env.local et remplis ce dont tu as besoin.
# Tout est optionnel : chaque brique absente bascule en mode démonstration
# plutôt que de casser le site.
# ---------------------------------------------------------------------------

# Base publique du site (liens dans les e-mails, redirections Stripe et OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : SERVEUR UNIQUEMENT. Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Fournisseurs de connexion affichés, dans l'ordre, séparés par des virgules.
# Valeurs possibles : google, azure (Microsoft), apple, linkedin_oidc, github.
# Chacun doit être activé dans Supabase > Authentication > Providers.
# Variable absente = google seul. Variable vide = lien e-mail uniquement.
NEXT_PUBLIC_AUTH_PROVIDERS=google,azure

# --- Moteurs de réponse -----------------------------------------------------
# Chaque clé absente = moteur signalé « non mesuré », jamais inventé.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=

# Modèles interrogés. Laisse vide pour les valeurs par défaut du code.
# OPENAI_AUDIT_MODEL=gpt-5
# PERPLEXITY_AUDIT_MODEL=sonar
# GEMINI_AUDIT_MODEL=gemini-2.5-flash

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- E-mail transactionnel (Resend) -----------------------------------------
RESEND_API_KEY=
RESEND_FROM="Wield <bonjour@wield.fr>"
# Destinataire des demandes d'infrastructure web
CONTACT_INBOX=

# --- Tâches planifiées ------------------------------------------------------
# Jeton partagé qui protège /api/cron/* (Vercel Cron l'envoie en Authorization)
CRON_SECRET=
